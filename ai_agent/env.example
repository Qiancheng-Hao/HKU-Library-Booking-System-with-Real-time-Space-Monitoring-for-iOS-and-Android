# =============================================================
# HKU Library AI Agent — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================

# --- LLM Provider (OpenAI-compatible) ---
# API key for your chosen LLM provider
AI_API_KEY=your_api_key_here

# Base URL of the OpenAI-compatible API endpoint
# DeepSeek:  https://api.deepseek.com
# OpenAI:    https://api.openai.com/v1
# Ollama:    http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com

# Model name to use (must be supported by the provider above)
# DeepSeek:  deepseek-chat
# OpenAI:    gpt-4o, gpt-4o-mini
AI_MODEL=deepseek-chat

# --- Server ---
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=8001

# --- Security ---
# Shared secret between this service and the backend (must match AI_AGENT_SHARED_SECRET in backend/.env)
# Leave empty to disable token verification during development
AI_AGENT_SHARED_SECRET=

# --- Session Management ---
AI_AGENT_SESSION_TIMEOUT_MINUTES=30
AI_AGENT_CLEANUP_INTERVAL_SECONDS=300

# --- Logging ---
# Set to false to disable ai_agent application logs
AI_AGENT_LOG_ENABLED=true
# Relative paths are resolved from ai_agent/
AI_AGENT_LOG_FILE_PATH=logs/ai_agent.log
